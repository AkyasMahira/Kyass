---
import { useTranslations } from '../i18n/utils';

const locale = Astro.currentLocale ?? 'id';
const t = useTranslations(locale);
const { process: data } = t;
---

<section class="mx-auto max-w-5xl px-6 py-24">
  <div class="mb-12">
    <h2 class="text-3xl font-medium tracking-tight text-primary">{data.heading}</h2>
    <p class="mt-2 text-secondary">{data.subtitle}</p>
  </div>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {data.steps.map((step, i) => (
      <div class="relative border-t border-border pt-6">
        <span class="mb-4 block font-mono text-xs text-secondary">0{i + 1}</span>
        <h3 class="mb-2 text-lg font-medium text-primary">{step.title}</h3>
        <p class="text-sm leading-relaxed text-secondary">{step.desc}</p>
      </div>
    ))}
  </div>
</section>
