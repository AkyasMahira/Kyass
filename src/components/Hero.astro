---
---

<section class="relative mx-auto flex min-h-[90vh] max-w-5xl flex-col justify-center px-6 pt-24">
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,#262626_1px,transparent_1px),linear-gradient(to_bottom,#262626_1px,transparent_1px)] bg-size-[4rem_4rem] mask-[radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)] opacity-20"></div>

  <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-8">
    <div class="flex flex-col items-start gap-6">
      <div class="flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1">
        <span class="h-2 w-2 animate-pulse rounded-full bg-black"></span>
        <span class="font-mono text-[10px] uppercase tracking-wider text-secondary">
          Available for freelance
        </span>
      </div>

      <h1 class="text-5xl font-medium tracking-tighter text-primary sm:text-6xl">
        Building modern, <br class="hidden sm:block" />
        <span class="text-secondary">fast & minimal</span> <br class="hidden sm:block" />
        web experiences.
      </h1>

      <p class="max-w-md text-base text-secondary">
        Web developer focused on high-performance websites, modern UI, and scalable frontend systems.
      </p>

      <div class="flex gap-4 pt-4">
        <a href="#contact" class="rounded-md bg-primary px-5 py-2.5 text-sm font-medium text-background transition-transform hover:scale-105">
          Start Project
        </a>
        <a href="#work" class="rounded-md border border-border bg-surface px-5 py-2.5 text-sm font-medium text-primary transition-colors hover:bg-border">
          View Work
        </a>
      </div>
    </div>

    <div class="relative hidden h-full w-full lg:block">
      <div class="absolute right-0 top-1/2 w-4/5 -translate-y-1/2 rounded-xl border border-border bg-surface/30 p-6 backdrop-blur-sm">
        <div class="mb-4 flex gap-2">
          <div class="h-3 w-3 rounded-full bg-border"></div>
          <div class="h-3 w-3 rounded-full bg-border"></div>
          <div class="h-3 w-3 rounded-full bg-border"></div>
        </div>
        <pre class="font-mono text-xs text-secondary"><code>const dev = &#123;
  name: 'zayssme',
  role: 'Web Developer',
  stack: ['Astro', 'Tailwind', 'TypeScript'],
  focus: [
    'Performance',
    'SEO',
    'Clean Architecture'
  ],
  quality: 'Premium & Minimal',
  fast: true
&#125;;

dev.build();</code></pre>
      </div>
    </div>
  </div>
</section>