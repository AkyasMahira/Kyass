---
import { useTranslations } from '../i18n/utils';

const locale = Astro.currentLocale ?? 'id';
const t = useTranslations(locale);
const { testimonials } = t;

const data = [
  {
    quote: locale === 'id'
      ? "Platform Sindikat sangat membantu manajemen diklat rumah sakit. Mulai dari pengajuan magang, tracking MOU mitra, jadwal ruangan, hingga sertifikat otomatis sekarang terintegrasi dalam satu dashboard terpusat yang sangat efisien."
      : "The Sindikat platform greatly streamlines hospital training management. From internship applications and partner MOU tracking to room scheduling and automated certificates, everything is now integrated into a highly efficient, centralized dashboard.",
    name: "Diklat RSUD SLG Kediri",
    role: "RSUD Simpang Lima Gumul Kediri",
  },
  {
    quote: locale === 'id'
      ? "Order untuk optimasi performa website, hasilnya sangat memuaskan. Loading yang tadinya lambat sekarang jadi jauh lebih cepat. Prosesnya juga cepat dan dikasih penjelasan apa aja yang dioptimasi. Worth it banget!"
      : "Ordered website performance optimization, and the results are highly satisfying. The previously slow loading is now much faster. The process was quick, and I received clear explanations of what was optimized. Totally worth it!",
    name: "Gilang",
    role: "Client, NugasReceh",
  },
  {
    quote: locale === 'id'
      ? "Bot Telegram ini sangat mempermudah dokter gigi ketika melakukan pencatatan pasien langsung di lapangan. Penginputan data jadi praktis dan tidak ribet."
      : "This Telegram bot makes it so much easier for a dentist to record patient data directly in the field. Data entry has become practical and hassle-free.",
    name: "Denist Fathur",
    role: "Clinical Dental Student",
  },
];
---

<section class="mx-auto max-w-5xl px-6 py-24">
  <div class="mb-12">
    <h2 class="text-3xl font-medium tracking-tight text-primary">{testimonials.heading}</h2>
    <p class="mt-2 text-secondary">{testimonials.subtitle}</p>
  </div>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {data.map((item) => (
      <div class="rounded-2xl border border-border bg-card p-8 flex flex-col justify-between">
        <blockquote class="mb-6 text-sm leading-relaxed text-secondary">
          &ldquo;{item.quote}&rdquo;
        </blockquote>
        <div>
          <p class="font-medium text-primary text-sm">{item.name}</p>
          <p class="font-mono text-xs text-secondary">{item.role}</p>
        </div>
      </div>
    ))}
  </div>
</section>
