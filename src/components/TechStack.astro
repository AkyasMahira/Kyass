---
const stacks = [
  'Astro',
  'Next.js',
  'TypeScript',
  'Tailwind CSS',
  'React',
  'Node.js'
];
---

<section class="mx-auto max-w-5xl px-6 py-12">
  <div class="flex flex-wrap items-center justify-center gap-3 md:gap-4">
    {stacks.map((tech) => (
      <div class="cursor-default rounded-full border border-border px-5 py-2 font-mono text-sm text-secondary transition-colors hover:bg-primary hover:text-background">
        {tech}
      </div>
    ))}
  </div>
</section>