---
import { useTranslations } from '../i18n/utils';

const locale = Astro.currentLocale ?? 'id';
const t = useTranslations(locale);
const { footer } = t;
const currentYear = new Date().getFullYear();
---

<footer id="contact" class="mt-12 border-t border-border bg-surface/30">
  <div class="mx-auto max-w-5xl px-6 py-24 text-center">
    <h2 class="mb-6 text-4xl font-medium tracking-tight text-primary sm:text-5xl">
      {footer.heading1} <span class="text-secondary">{footer.heading2}</span>
    </h2>
    <p class="mx-auto mb-10 max-w-md text-secondary">
      {footer.description}
    </p>
    <a href="mailto:akyasmahira.business@gmail.com" class="inline-flex rounded-md bg-primary px-8 py-3 text-sm font-medium text-background transition-transform hover:scale-105">
      {footer.cta}
    </a>
  </div>

  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between border-t border-border/50 px-6 py-8 sm:flex-row">
    <p class="mb-4 font-mono text-xs text-secondary sm:mb-0">
      &copy; {currentYear} zayssme. {footer.rights}
    </p>
    <div class="flex gap-6 font-mono text-xs">
      <a href="https://github.com/AkyasMahira" class="text-secondary transition-colors hover:text-primary">github</a>
      <a href="https://www.linkedin.com/in/akyasmahira" class="text-secondary transition-colors hover:text-primary">linkedin</a>
      <a href="https://www.instagram.com/zayssme" class="text-secondary transition-colors hover:text-primary">instagram</a>
    </div>
  </div>
</footer>
