---
import { useTranslations } from '../i18n/utils';

const locale = Astro.currentLocale ?? 'id';
const t = useTranslations(locale);
const { services } = t;
const serviceIcons = [
  '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 18l6-6-6-6M8 6l-6 6 6 6"/></svg>',
  '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4"/><path d="M8 4h8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M9 16h6"/><path d="M8 12h.01"/><path d="M16 12h.01"/></svg>',
  '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>',
];
---

<section id="services" class="mx-auto max-w-5xl px-6 py-24">
  <div class="mb-12">
    <h2 class="text-3xl font-medium tracking-tight text-primary">{services.heading}</h2>
    <p class="mt-2 text-secondary">{services.subtitle}</p>
  </div>

  <div class="grid gap-6 md:grid-cols-3">
    {services.items.map((service, i) => (
      <div class="group rounded-2xl border border-border bg-card p-8 transition-transform hover:-translate-y-1">
        <div class="mb-6 inline-flex rounded-lg bg-surface p-3 text-primary ring-1 ring-border" set:html={serviceIcons[i]} />
        <h3 class="mb-3 text-lg font-medium text-primary">{service.title}</h3>
        <p class="text-sm leading-relaxed text-secondary">{service.desc}</p>
      </div>
    ))}
  </div>
</section>
