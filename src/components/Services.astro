---
// Menggunakan inline SVG agar ringan dan tidak perlu library tambahan
const services = [
  {
    title: 'Website Development',
    description: 'Membangun website statis dan dinamis dengan performa tinggi menggunakan Astro dan Next.js.',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 18l6-6-6-6M8 6l-6 6 6 6"/></svg>'
  },
  {
    title: 'UI Implementation',
    description: 'Menerjemahkan desain ke dalam kode pixel-perfect menggunakan Tailwind CSS dan React.',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M9 21V9"/></svg>'
  },
  {
    title: 'Performance Optimization',
    description: 'Audit dan optimalisasi Lighthouse score, SEO, dan waktu muat (load time) website.',
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>'
  }
];
---

<section id="services" class="mx-auto max-w-5xl px-6 py-24">
  <div class="mb-12">
    <h2 class="text-3xl font-medium tracking-tight text-primary">Services</h2>
    <p class="mt-2 text-secondary">What I can do for you.</p>
  </div>

  <div class="grid gap-6 md:grid-cols-3">
    {services.map((service) => (
      <div class="group rounded-2xl border border-border bg-card p-8 transition-transform hover:-translate-y-1">
        <div class="mb-6 inline-flex rounded-lg bg-surface p-3 text-primary ring-1 ring-border" set:html={service.icon} />
        <h3 class="mb-3 text-lg font-medium text-primary">{service.title}</h3>
        <p class="text-sm leading-relaxed text-secondary">{service.description}</p>
      </div>
    ))}
  </div>
</section>